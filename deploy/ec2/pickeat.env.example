# t3.micro(1GB) 기준. 메모리가 부족하면 Xmx를 먼저 조정한다.
JAVA_OPTS=-Xms256m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/pick_eat
DB_USERNAME=pick_eat
DB_PASSWORD=__DB_PASSWORD__
JWT_SECRET=__JWT_SECRET__
JWT_ACCESS_TOKEN_VALIDITY_MS=1800000
GOOGLE_PLACES_API_KEY=CHANGE_ME
