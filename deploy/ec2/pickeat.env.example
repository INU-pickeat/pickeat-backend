# t3.micro(1GB) 기준. 메모리가 부족하면 Xmx를 먼저 조정한다.
JAVA_OPTS=-Xms256m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/pick_eat
DB_USERNAME=pick_eat
DB_PASSWORD=__DB_PASSWORD__
JWT_SECRET=__JWT_SECRET__
JWT_ACCESS_TOKEN_VALIDITY_MS=1800000
GOOGLE_PLACES_API_KEY=CHANGE_ME
# cki08543@gmail.com 계정의 SMTP 앱 비밀번호를 사용한다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=cki08543@gmail.com
MAIL_PASSWORD=__MAIL_APP_PASSWORD__
MAIL_FROM=cki08543@gmail.com
# Vercel 미리보기 도메인이 필요하면 https://<프로젝트명>-*.vercel.app 패턴을 추가한다.
CORS_ALLOWED_ORIGINS=https://www.pickeat.kr,https://pickeat.kr
# 후기 이미지 S3 버킷. 비워 두면 이미지 업로드 URL 발급만 꺼진다. 자격 증명은 EC2 인스턴스 역할에서 읽는다.
REVIEW_IMAGE_BUCKET=
REVIEW_IMAGE_REGION=ap-northeast-2
# CloudFront를 붙였으면 https://xxxx.cloudfront.net, 아니면 비워 둔다.
REVIEW_IMAGE_BASE_URL=
